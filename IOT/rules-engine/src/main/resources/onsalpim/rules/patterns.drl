// 온살핌 시간 패턴 (CEP) — 한 시점의 값이 아니라 "시간에 걸친 흐름"을 본다.
//
//   고온 지속 + 무활동   30분 넘게 고온 기준 이상인데 그동안 움직임이 없다      → 긴급 확인
//   오전 첫 움직임 없음  세대별 기준 시각이 지났는데 오늘 아침 움직임이 없다    → 생활 확인
//   새벽 배회 의심       새벽 시간대 최근 1시간 움직임 감지가 기준 횟수 이상    → 생활 확인
//   오전 활동 비율 저하  평가 시각(08~11시) 직전 1시간 10분 칸 6개가 모두 관측됐고, 활동 칸 비율이
//                        개인 기준 θ 미만이며 연속 무활동 30분 이상 — 가장 최근 검증 가능한 창 기준 → 생활 확인
//   저온 지속 + 무활동   30분 넘게 저온 기준 이하인데 그동안 움직임이 없다      → 긴급 확인
//   습도 이상 + 활동 감소 60분 넘게 습도가 정상 범위 밖이고 그동안 움직임 2회 이하 → 생활 확인
//   주간 활동 급감       낮 시간에 최근 3시간 활동 칸 비율이 직전 3시간의 30% 이하 (직전 40% 이상,
//                        두 구간 모두 18칸 중 16칸 이상 관측)                   → 생활 확인
//   반복 활동 감소       3일 연속 하루 활동 비율이 그 전 14일 평균의 70% 미만 (10일 이상)  → 생활 확인
//   생활 일정            승인된 외출·수면 일정 중이면 주의 단계 생활 알림 보류 (긴급은 보류하지 않음),
//                        일정이 끝나고 30분이 지나도 움직임이 없으면 추가 확인   → 생활 확인
//   센서값 고정          3시간 동안 온도·습도가 모두 한 값 (30회 이상 측정), 또는 최근 10분 측정이
//                        물리 범위 밖                                              → 장치 점검
//   알림 미대응          대응 없이 10분 → 재통지, 20분 → 다음 담당자에게
//
// Drools STREAM 모드. 모든 사실은 이벤트(@timestamp)이고 세션 시계(가상 시계)는 요청의 '지금'에 맞춘다.
// 'tick' 이벤트가 지금이다 — "A before[0s,30m] tick" = A 가 지금으로부터 30분 안에 있었다.
// 패턴과 시간 길이(30분·1시간·10분·20분)는 이 파일에 고정이다. 세대마다 다른 것(고온 기준·기준 시각·횟수)은
// Home 데이터로 들어온다 — 채팅 → AI 초안 → 검사 → 승인을 거친 정책 데이터. AI 가 이 파일을 쓰지 않는다.

package onsalpim.rules

import onsalpim.rules.Ev
import onsalpim.rules.Home
import onsalpim.rules.Finding

declare Ev
    @role( event )
    @timestamp( ts )
end

// 오전 시간창 중간 결과 — 'slot'(10분 칸, value 1=활동 0=무활동, 관측된 칸만 들어온다)과
// 'window'(평가 시각, value=θ) 이벤트로 만든다
declare Verifiable
    home : String
    at : long
end

declare LowWindow
    home : String
    at : long
end

rule "고온 지속 + 무활동 30분"
when
    $t : Ev( type == "tick" )
    $h : Home( hotC != null )
    exists Ev( home == $h.id, type == "temp", value >= $h.hotC, this before[25m, 30m] $t )     // 30분 전에도 더웠고
    exists Ev( home == $h.id, type == "temp", value >= $h.hotC, this before[0s, 5m] $t )       // 지금도 덥고
    not Ev( home == $h.id, type == "temp", value < $h.hotC, this before[0s, 30m] $t )          // 그 사이 내려간 적 없고
    not Ev( home == $h.id, type == "motion", this before[0s, 30m] $t )                         // 그동안 움직임이 없다
    not Finding( home == $h.id, code == "HOT_IDLE" )
then
    insert( new Finding( $h.getId(), "HOT_IDLE", $t.getTs() - 30 * 60000L, null ) );
end

rule "오전 기준 시각까지 첫 움직임 없음"
when
    $t : Ev( type == "tick" )
    $h : Home( morningBy != null, morningBy <= $t.ts )
    not Ev( home == $h.id, type == "motion", ts >= $h.morningFrom )
then
    insert( new Finding( $h.getId(), "MORNING_NONE", $h.getMorningBy(), null ) );
end

rule "오전 시간창 — 6칸 모두 관측 (검증 가능)"
when
    $t : Ev( type == "tick" )
    $w : Ev( type == "window", ts <= $t.ts )
    accumulate( Ev( home == $w.home, type == "slot", ts >= $w.ts - 3600000L, ts < $w.ts ); $n : count(); $n == 6 )
then
    insert( new Verifiable( $w.getHome(), $w.getTs() ) );
end

rule "오전 시간창 — 활동 비율 θ 미만 + 연속 무활동 30분"
when
    $v : Verifiable( $home : home, $at : at )
    $w : Ev( type == "window", home == $home, ts == $at )
    accumulate( Ev( home == $home, type == "slot", ts >= $at - 3600000L, ts < $at, $x : value ); $act : sum( $x );
                $act / 6.0 < $w.value )
    exists ( Ev( home == $home, type == "slot", value == 0, $s : ts, ts >= $at - 3600000L, ts <= $at - 1800000L )
             and Ev( home == $home, type == "slot", value == 0, ts == $s + 600000L )
             and Ev( home == $home, type == "slot", value == 0, ts == $s + 1200000L ) )
then
    insert( new LowWindow( $home, $at ) );
end

rule "오전 활동 비율 저하 — 가장 최근 검증 가능한 창"
when
    $l : LowWindow( $home : home, $at : at )
    not Verifiable( home == $home, at > $at )
then
    insert( new Finding( $home, "MORNING_LOW", $at, null ) );
end

rule "저온 지속 + 무활동 30분"
when
    $t : Ev( type == "tick" )
    $h : Home( coldC != null )
    exists Ev( home == $h.id, type == "temp", value <= $h.coldC, this before[25m, 30m] $t )
    exists Ev( home == $h.id, type == "temp", value <= $h.coldC, this before[0s, 5m] $t )
    not Ev( home == $h.id, type == "temp", value > $h.coldC, this before[0s, 30m] $t )
    not Ev( home == $h.id, type == "motion", this before[0s, 30m] $t )
then
    insert( new Finding( $h.getId(), "COLD_IDLE", $t.getTs() - 30 * 60000L, null ) );
end

rule "습도 이상 60분 + 활동 감소"
when
    $t : Ev( type == "tick" )
    $h : Home( humidLo != null, humidHi != null )
    exists Ev( home == $h.id, type == "humid", value < $h.humidLo || value > $h.humidHi, this before[55m, 60m] $t )
    exists Ev( home == $h.id, type == "humid", value < $h.humidLo || value > $h.humidHi, this before[0s, 5m] $t )
    not Ev( home == $h.id, type == "humid", value >= $h.humidLo && value <= $h.humidHi, this before[0s, 60m] $t )
    accumulate( Ev( home == $h.id, type == "motion", this before[0s, 60m] $t ); $n : count(); $n <= 2 )
then
    insert( new Finding( $h.getId(), "HUMID_IDLE", $t.getTs() - 60 * 60000L, null ) );
end

rule "주간 활동 급감 — 최근 3시간 vs 직전 3시간"
when
    $t : Ev( type == "tick" )
    $h : Home( dayFrom != null, dayFrom <= $t.ts, dayTo > $t.ts )
    accumulate( Ev( home == $h.id, type == "slot", ts >= $t.ts - 10800000L, ts < $t.ts, $a : value );
                $n1 : count(), $a1 : sum( $a ); $n1 >= 16 )
    accumulate( Ev( home == $h.id, type == "slot", ts >= $t.ts - 21600000L, ts < $t.ts - 10800000L, $b : value );
                $n0 : count(), $a0 : sum( $b ); $n0 >= 16, $a0 / $n0 >= 0.4, $a1 / $n1 <= 0.3 * ( $a0 / $n0 ) )
then
    insert( new Finding( $h.getId(), "DAY_DROP", $t.getTs() - 10800000L, null ) );
end

rule "반복 활동 감소 — 3일 연속 평소의 70% 미만"
when
    $t : Ev( type == "tick" )
    $d3 : Ev( type == "day", $home : home, ts <= $t.ts )
    not Ev( type == "day", home == $home, ts > $d3.ts, ts <= $t.ts )
    $d2 : Ev( type == "day", home == $home, ts == $d3.ts - 86400000L )
    $d1 : Ev( type == "day", home == $home, ts == $d3.ts - 172800000L )
    accumulate( Ev( type == "day", home == $home, ts < $d1.ts, ts >= $d1.ts - 1209600000L, $v : value );
                $avg : average( $v ), $n : count();
                $n >= 10, $d1.value < 0.7 * $avg, $d2.value < 0.7 * $avg, $d3.value < 0.7 * $avg )
then
    insert( new Finding( $home, "DAILY_DECLINE", $d1.getTs(), null ) );
end

rule "생활 일정 중 — 주의 단계 생활 알림 보류"
when
    $t : Ev( type == "tick" )
    $r : Ev( type == "routine", ts <= $t.ts, value > $t.ts )
    not Finding( home == $r.home, code == "ROUTINE_HOLD" )
then
    insert( new Finding( $r.getHome(), "ROUTINE_HOLD", $r.getTs(), $r.getRef() ) );
end

rule "생활 일정이 끝나고 30분 — 움직임 없음"
when
    $t : Ev( type == "tick" )
    $r : Ev( type == "routine", value + 1800000 <= $t.ts, value + 21600000 > $t.ts )
    not Ev( home == $r.home, type == "motion", ts >= $r.value, ts <= $t.ts )
    not Ev( type == "routine", home == $r.home, ts <= $t.ts, value > $t.ts )
    not Finding( home == $r.home, code == "ROUTINE_OVERDUE" )
then
    insert( new Finding( $r.getHome(), "ROUTINE_OVERDUE", $r.getValue().longValue(), $r.getRef() ) );
end

rule "센서값 고정 — 3시간 동안 온도·습도 모두 한 값"
when
    $t : Ev( type == "tick" )
    $h : Home()
    accumulate( Ev( home == $h.id, type == "temp", this before[0s, 180m] $t, $x : value );
                $tn : count(), $tmin : min( $x ), $tmax : max( $x ); $tn >= 30, $tmin == $tmax )
    accumulate( Ev( home == $h.id, type == "humid", this before[0s, 180m] $t, $y : value );
                $hn : count(), $hmin : min( $y ), $hmax : max( $y ); $hn >= 30, $hmin == $hmax )
    not Finding( home == $h.id, code == "SENSOR_STUCK" )
then
    insert( new Finding( $h.getId(), "SENSOR_STUCK", $t.getTs() - 10800000L, "고정" ) );
end

rule "센서값 범위 밖 — 최근 10분"
when
    $t : Ev( type == "tick" )
    $h : Home()
    exists Ev( home == $h.id, ( type == "temp" && ( value < -20 || value > 70 ) )
                             || ( type == "humid" && ( value < 0 || value > 100 ) ), this before[0s, 10m] $t )
    not Finding( home == $h.id, code == "SENSOR_STUCK" )
then
    insert( new Finding( $h.getId(), "SENSOR_STUCK", null, "범위 밖" ) );
end

rule "새벽 배회 의심 — 최근 1시간 움직임 감지 횟수"
when
    $t : Ev( type == "tick" )
    $h : Home( wanderCount != null, nightFrom <= $t.ts, nightTo > $t.ts )
    accumulate( $m : Ev( home == $h.id, type == "motion", ts >= $h.nightFrom ) over window:time( 60m );
                $n : count( $m );
                $n >= $h.wanderCount )
then
    insert( new Finding( $h.getId(), "NIGHT_WANDER", null, null ) );
end

rule "알림 미대응 20분 → 다음 담당자"
    salience 10
when
    $t : Ev( type == "tick" )
    $a : Ev( type == "alert", this before[20m] $t )
    not Ev( type == "action", ref == $a.ref )
then
    insert( new Finding( $a.getHome(), "ESCALATE", $a.getTs(), $a.getRef() ) );
end

rule "알림 미대응 10분 → 재통지"
when
    $t : Ev( type == "tick" )
    $a : Ev( type == "alert", this before[10m] $t )
    not Ev( type == "action", ref == $a.ref )
    not Finding( ref == $a.ref )
then
    insert( new Finding( $a.getHome(), "RENOTIFY", $a.getTs(), $a.getRef() ) );
end
