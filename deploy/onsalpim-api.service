[Unit]
Description=Onsalpim REST API (Gunicorn)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=@DEPLOY_USER@
Group=@DEPLOY_USER@
WorkingDirectory=@DEPLOY_ROOT@/IOT
Environment=PYTHONUTF8=1
Environment=PYTHONUNBUFFERED=1
ExecStart=@DEPLOY_ROOT@/IOT/.venv/bin/gunicorn -w 2 -b 127.0.0.1:5001 --timeout 120 api_server:app
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
